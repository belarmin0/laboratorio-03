pipeline {
    agent {
        kubernetes {
            yamlFile 'agent.yaml'
        }
    }
    environment {
        DH_REGISTRY_USER = 'miguelbelarmino'
        GH_REGISTRY_USER = 'belarmin0'
        IMAGE_NAME = 'laboratorio-03'
        APP_VERSION = '3.0'
        IMAGE_TAG = "miguel-alarcon"
        DH_REPO = 'miguelbelarmino/laboratorio-03'
        GH_REPO = 'ghcr.io/miguelbelarmino/laboratorio03'
        LAB_NAMESPACE = 'ns-miguel-alarcon'
    }
    stages{
        stage('Install') {
            steps {
                container('node-pnpm'){
                    echo 'Instalado dependencias...'
                    sh 'corepack enable'
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }
        stage('Test') {
            steps {
                container('node-pnpm') {
                    echo 'Ejecutando pruebas...'
                    sh 'pnpm lint'
                    sh 'pnpm test --coverage'
                }
            }
        }
        stage('Build') {
            steps {
                container('buildkit') {
                    echo 'Construyendo imagen ...'
                //    sh "docker build -t ${DH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
                //    sh "docker build -t ${DH_REGISTRY_USER}/${IMAGE_NAME}:${APP_VERSION} ."
                //    sh "docker build -t ghcr.io/${GH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
                //    sh "docker build -t ghcr.io/${GH_REGISTRY_USER}/${IMAGE_NAME}:${APP_VERSION} ."
                sh '''
                buildkitd --allow-insecure-entitlement security.insecure &
                sleep 5
                buildctl build --frontend=dockerfile.v0 --local context=. --local dockerfile=.
                '''
                }
            }
        }
        stage('Push') {
            steps {
                container('buildkit') {
                    echo 'Subiendo imagen a repositorio...'
                    sh '''
                    # 1. Definir la ruta del secreto montado por Kubernetes
                    export DOCKER_CONFIG=/docker-configs/dockerhub
                    
                    # 2. Iniciar demonio pasando la configuración del secreto montado
                    # BuildKit heredará la variable DOCKER_CONFIG de este entorno
                    pgrep buildkitd || (buildkitd --addr unix:///run/buildkit/buildkitd.sock --allow-insecure-entitlement security.insecure &)
                    
                    # 3. Esperar al socket
                    for i in {1..10}; do [ -S /run/buildkit/buildkitd.sock ] && break || sleep 1; done
                    
                    # 4. Construir y empujar
                    # Al tener DOCKER_CONFIG=/docker-configs/dockerhub, buildctl leerá el config.json del secret
                    buildctl --addr unix:///run/buildkit/buildkitd.sock build \
                        --frontend=dockerfile.v0 \
                        --local context=. \
                        --local dockerfile=. \
                        --output type=image,"name=docker.io/miguelbelarmino/laboratorio-03:${IMAGE_TAG}",push=true \
                        --output type=image,"name=docker.io/miguelbelarmino/laboratorio-03:${APP_VERSION}",push=true

                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
               container('kubectl') {
                    echo 'Desplegando...'
                    sh 'kubectl apply -f entrega.yaml'
                    sh 'kubectl rollout status deployment/app-miguel-alarcon -n ns-miguel-alarcon'
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado.'
        }
    }
}