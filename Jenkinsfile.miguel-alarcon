pipeline {
    agent {
        kubernetes {
            yamlFile 'agent.yaml'
        }
    }
    environment {
        DH_REGISTRY_USER = 'miguelbelarmino'
        GH_REGISTRY_USER = 'belarmin0'
        IMAGE_NAME = 'laboratorio-03'
        APP_VERSION = '3.0'
        IMAGE_TAG = "miguel-alarcon"
        DH_REPO = 'miguelbelarmino/laboratorio-03'
        GH_REPO = 'ghcr.io/miguelbelarmino/laboratorio03'
    }
    stages{
        stage('Install') {
            steps {
                container('pnpm'){
                    echo 'Instalado dependencias...'
                    sh 'npm ci'
                }
            }
        }
        stage('Test') {
            steps {
                container('node') {
                    echo 'Ejecutando pruebas...'
                    sh 'npm test -- --coverage'
                }
            }
        }
        stage('Build') {
            steps {
                container('buildkit') {
                    echo 'Construyendo imagen ...'
                    sh 'docker build -t $REGISTRY_USER/$IMAGE_NAME:$IMAGE_TAG .'
                    sh 'docker build -t $REGISTRY_USER/$IMAGE_NAME:$APP_VERSION .'
                }
            }
        }
        stage('Push') {
            steps {
                container('buildkit') {
                    echo 'Subiendo imagen a repositorio...'
                    sh '''
                        export DOCKER_CONFIG=/docker-configs/dockerhub
                        test -s "$(DOCKER_CONFIG)/config.json" || (echo "DockerHub config not found" && exit 1)
                        export DOCKER_CONFIG=/docker-configs/github
                        test -s "$(DOCKER_CONFIG)/config.json" || (echo "GitHub config not found" && exit 1)
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
               container('kubectl') {
                    echo 'Desplegando...'
                    sh 'kubectl apply -f entrega.yaml'
                    echo 'Verificando despliegue...'
                    sh 'kubectl rollout status deployment/app-miguel-alarcon -n ns-miguel-alarcon'
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado.'
        }
    }
}