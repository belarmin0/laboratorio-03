pipeline {
    agent {
        kubernetes {
            yamlFile 'agent.yaml'
        }
    }
    environment {
        DH_REGISTRY_USER = 'miguelbelarmino'
        GH_REGISTRY_USER = 'belarmin0'
        IMAGE_NAME = 'laboratorio-03'
        APP_VERSION = '3.0'
        IMAGE_TAG = "miguel-alarcon"
        DH_REPO = 'miguelbelarmino/laboratorio-03'
        GH_REPO = 'ghcr.io/miguelbelarmino/laboratorio03'
    }
    stages{
        stage('Install') {
            steps {
                container('node-pnpm'){
                    echo 'Instalado dependencias...'
                    sh 'corepack enable'
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }
        stage('Test') {
            steps {
                container('node-pnpm') {
                    echo 'Ejecutando pruebas...'
                    sh 'npm test -- --coverage'
                }
            }
        }
        stage('Build') {
            steps {
                container('docker-cli') {
                    echo 'Construyendo imagen ...'
                    sh "docker build -t ${DH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker build -t ${DH_REGISTRY_USER}/${IMAGE_NAME}:${APP_VERSION} ."
                    sh "docker build -t ghcr.io/${GH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker build -t ghcr.io/${GH_REGISTRY_USER}/${IMAGE_NAME}:${APP_VERSION} ."
                }
            }
        }
        stage('Push') {
            steps {
                container('docker-cli') {
                    echo 'Subiendo imagen a repositorio...'
//                    sh '''
//                        export DOCKER_CONFIG=/docker-configs/dockerhub
//                        test -s "$(DOCKER_CONFIG)/config.json" || (echo "DockerHub config not found" && exit 1)
//                        export DOCKER_CONFIG=/docker-configs/github
//                        test -s "$(DOCKER_CONFIG)/config.json" || (echo "GitHub config not found" && exit 1)
//                    '''
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                        sh "docker push ${DH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                        sh "docker push ${DH_REGISTRY_USER}/${IMAGE_NAME}:${APP_VERSION}"
                    }
                    withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GH_USER', passwordVariable: 'GH_PASS')]) {
                        sh "echo \$GH_PASS | docker login ghcr.io -u \$GH_USER --password-stdin"
                        sh "docker push ghcr.io/${GH_REGISTRY_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
               container('kubectl') {
                    echo 'Desplegando...'
                    sh 'kubectl apply -f entrega.yaml'
                    echo 'Verificando despliegue...'
                    sh 'kubectl rollout status deployment/app-miguel-alarcon -n ns-miguel-alarcon'
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado.'
        }
    }
}